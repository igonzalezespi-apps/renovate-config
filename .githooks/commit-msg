#!/usr/bin/env sh
# Public repo — private-reference check on the COMMIT MESSAGE itself.
#
# pre-commit scans the staged files; nothing there looks at the message text, so a message naming
# a private project would pass every other local gate. $1 is the file git hands us with the
# message being authored. See private-refs-checker.sh for where the checker is looked up and when
# a missing one fails closed (the maintainer's clones) or is a no-op (forks).
#
# Enable per clone: git config core.hooksPath .githooks
set -eu

. "$(dirname -- "$0")/private-refs-checker.sh"

if [ -n "$PRIVATE_REFS_CHECKER" ]; then
  "$PRIVATE_REFS_CHECKER" "$1"
fi
